{
  "name": "velox-nexus",
  "version": "3.0.0",
  "description": "VELOX NEXUS — all-platform media downloader + GitHub push workspace. 34 platforms, adaptive resolver chains, browser-only GitHub tokens.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test test/unit/ test/frontend/",
    "test:live": "node --test test/live/",
    "test:all": "node --test test/unit/ test/frontend/ test/live/",
    "verify:docker": "bash scripts/verify-docker-order.sh",
    "postinstall": "node scripts/ensure-ytdlp.js",
    "ensure-engine": "node scripts/ensure-ytdlp.js"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "ipaddr.js": "2.3.0",
    "json5": "2.2.3",
    "undici": "7.30.0"
  },
  "keywords": [
    "downloader",
    "yt-dlp",
    "github",
    "push-to-github",
    "tiktok",
    "instagram",
    "youtube",
    "twitter",
    "facebook",
    "pinterest",
    "social-media",
    "no-watermark",
    "railway"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
