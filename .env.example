# ==========================================================================
# VELOX NEXUS — environment
# Copy to .env for local dev. On Railway: Project → Variables.
# Everything is OPTIONAL — the defaults work out of the box.
# ==========================================================================

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

APP_NAME=VELOX
APP_FULL_NAME=VELOX NEXUS
APP_TAGLINE=Simpan inspirasimu. Kirim ke repo-mu.
# Public origin of the deployment, e.g. https://velox.up.railway.app
PUBLIC_URL=

# Behind Railway's proxy this must stay true so rate limiting sees real IPs.
TRUST_PROXY=true

# ── Engine ────────────────────────────────────────────────────────────────
# Explicit path to the binary. Empty = auto-detect (env → PATH → python module
# → ./vendor/yt-dlp standalone).
YT_DLP_PATH=
YTDLP_AUTO_INSTALL=true
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_HOURS=12
FFMPEG_PATH=ffmpeg
# Netscape cookies.txt for Instagram / age-gated / members-only content.
# Export from your browser with an extension like "Get cookies.txt LOCALLY".
YTDLP_COOKIES=

# ── Behaviour ─────────────────────────────────────────────────────────────
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=500
RESOLVE_TIMEOUT_SECONDS=45
MAX_PLAYLIST_ITEMS=30
# Cap for the merged "best quality" option. 4K/8K sources are hundreds of MB
# and will exhaust a small instance's disk mid-request.
MAX_MERGE_HEIGHT=1080
MAX_CONCURRENT_RESOLVE=4
MAX_URL_LENGTH=2048

# ── Protection ────────────────────────────────────────────────────────────
RATE_WINDOW_SECONDS=60
RATE_MAX_RESOLVE=20
RATE_MAX_DOWNLOAD=40
RATE_MAX_GLOBAL=120
# Let /api/dl relay allowlisted platform CDNs. Turn off to force engine-only.
ALLOW_DIRECT_PROXY=true
# 'self' = only this origin may call the API. '*' or a comma separated list
# opens it up (do that only if you actually want a public JSON API).
CORS_ORIGIN=self

# Security headers
ENABLE_HSTS=true
HSTS_MAX_AGE=15552000
# Allow the app to be embedded in an iframe (turn on ONLY for a trusted
# development preview; production should stay false).
ALLOW_EMBED_PREVIEW=false
# Extra origins for CSP connect-src / script-src, comma separated.
CSP_EXTRA=
# Contact line for /.well-known/security.txt
SECURITY_CONTACT=mailto:you@example.com

# ── Third-party fallback providers (keyless) ──────────────────────────────
# Comma separated list to switch providers off:
# izuka,savefbs,azbry,threadsworker,fxtwitter,vxtwitter,piped,invidious
PROVIDERS_DISABLED=
PROVIDER_TIMEOUT_SECONDS=15
IZUKA_BASE=https://my.izuka-api.xyz
SAVEFBS_BASE=https://savefbs.com
AZBRY_BASE=https://api.azbry.com
THREADS_WORKER_BASE=

# X / Twitter JSON providers
FX_BASE=https://api.fxtwitter.com
VX_BASE=https://api.vxtwitter.com

# YouTube alternative front-ends (used only when yt-dlp is blocked)
YOUTUBE_FALLBACK_ENABLED=true
PIPED_BASES=https://pipedapi.kavin.rocks,https://api.piped.private.coffee
INVIDIOUS_BASES=https://inv.nadeko.net,https://invidious.nerdvpn.de

# Adaptive routing: remember which resolver actually worked and prefer it.
ADAPTIVE_ROUTING=true
HEALTH_DECAY_MINUTES=30

# Engine circuit breaker: after N bot-check/login failures for one platform,
# yt-dlp moves to the end of that platform's chain for M minutes.
ENGINE_BREAKER_THRESHOLD=2
ENGINE_BREAKER_MINUTES=15

# ── Optional upstreams ────────────────────────────────────────────────────
APP_USER_AGENT=
# Your own Instagram resolver (must accept ?url=... or contain {url}).
IG_API_ENDPOINT=
# A SELF-HOSTED cobalt instance. api.cobalt.tools requires Turnstile/JWT and
# will not work as a dependency.
COBALT_BASE=
COBALT_API_KEY=

# Optional Spotify official preview lookup for individual tracks only.
# Without these, public oEmbed metadata still works.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# coflyn/scrapr adapters: isolated to Spotify, Reddit and Bilibili.
SCRAPR_ENABLED=true
SCRAPR_DISABLED=
SCRAPR_TIMEOUT_SECONDS=12
SCRAPR_MAX_DOWNLOAD_MB=128

# ── GitHub push module ────────────────────────────────────────────────────
# Guard rails read by the browser through /api/capabilities.
# The GitHub token itself is NEVER an environment variable: it stays in the
# user's browser and is never sent to this server. Do not add one.
GH_MAX_FILE_MB=45
GH_MAX_FILES=1500
GH_MAX_TOTAL_MB=220
